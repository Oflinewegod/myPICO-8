--built in

function _init()
	b={
		x=0,
		y=0,
		vx=0,
		vy=0,
		a=1,
	}
	
	
end

function _update()

end

function _draw()
	cls()
	ball()
end
-->8
-- things
function ball()
	spr(b.a,b.x,b.y)
	
	b.vy+=1
	
	if (b.vy>4) b.vy=6
	
	b.x+=b.vx
	b.y+=b.vy
end



