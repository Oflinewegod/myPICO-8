pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--[[current task:

	make the cards flippable.

]]

--built in

function _init() 
	cards={ --{num, suit, flipped, x, y}
		{1,1,false,12,12},
		{1,2,false,24,24},
		{1,3,true,36,36},
		{1,4,false,48,48}
	}
end

function _draw()
 cls()
 drawcards()
end
-->8
--cards

function drawcard(num,suit,x,y)
	spr(1,x,y,2,2)
	if (suit>2) pal(5,8) --if red suit
	spr(num+2,x,y)	
	pal()
	spr(suit+18,x+3,y+6)
end

function flipcard(cardnum)
	c = cards[card]
	f=1 --animation frame
	for i=1,8,1 do
		spr(f+63,c[4],c[5],2,2)
		yield()
		f+=2
	end
end

function drawcards()
	
	for i=1, #cards do
		c = cards[i]
		if c[3]==false then
			drawcard(c[1],c[2],32+i*16,32)
		else
			spr(64,32+i*16,32,2,2)
		end
	end
end

function flipcards()
	for i=1,#cards do
	 
	end
end
