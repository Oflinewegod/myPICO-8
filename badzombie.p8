pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--built in

function _init()
	mobs={} --list of active mobs	
	
	add(mobs, {x=16,y=16})
	add(mobs, {x=32,y=16})
	
	p={ --player
		x=0,
		y=0,
	}
end

function _update()
	updatemobs()
end

function _draw()
	cls()
	drawmobs()
	spr(1, p.x, p.y)
end
-->8
--mob functions

function drawmob(self)
	spr(2,self.x,self.y)
end

function follow(self, target)
	self.x += dif(target.x)
	self.y += dif(target.x)
end

function drawmobs()
	for i=1,#mobs do
		drawmob(mobs[i])
	end
end

function updatemobs()
	for i=1,#mobs do
		follow(mobs[i], p)
	end
end
-->8
--other

function dif(num)
	return num/abs(num)
end
