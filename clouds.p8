--player

function updateplayer()
	--set names, saves tokens▒
	x=p.x
	y=p.y
	vx=p.vx
	vy=p.vy
	a=p.a
	
	
	
	
	if vy <=0 then --if falling
		--check for cloud collision▒
		--white cloud
		if fget(mget(x/8,y/8+1),1) then
			
		--gray cloud
		elseif fget(mget(x/8,y/8+1),1) then
		
		end
	end
	
	
	--player physics▒
	x+=vx
	y+=vy

	spr(a,x,y)
end


