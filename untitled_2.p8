end

function _draw()
	cls()
	updateball()
end
-->8
--ball

function updateball()
	--move the ball
	if (btn(⬅️)) ball.vx -= 1
	if (btn(➡️)) ball.vx += 1
	
	--limit velocity
	if ball.s == "idle" then
		
	elseif ball.s == "move" then
		
	end
	
	--update the balls position
	ball.x += ball.vx
	ball.y += ball.vy
	
	--finally, draw ball
	spr(ball.f+1, ball.x, ball.y)
end	


