version 43
__lua__
--built in

function _draw()
 cls()
	drawcard(2,1)
end
-->8
--cards

function drawcard(num,suit)
	spr(1,32,32,2,2)
	if (suit>2) pal(5,8)
	spr(num+2,32,32)
	pal()
end
